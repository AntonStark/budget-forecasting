{
  "compilerOptions": {
    "alwaysStrict": true,
    "allowJs": true,
    "baseUrl": "src/",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2019",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "node",
    //    "strict": true,
    "target": "ESNext",
    "noEmit": true,
    "paths": {
      "@/components/*": [
        "components/*"
      ],
      "@/models": [
        "models"
      ],
      "@/pages/*": [
        "pages/*"
      ],
      "@/schema/*": [
        "schema/*"
      ],
      "@/styles/*": [
        "styles/*"
      ],
      "@/types": [
        "types"
      ],
      "@/utils/*": [
        "utils/*"
      ],
      "@/sqlite/*": [
        "adapters/sqlite/*"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}
