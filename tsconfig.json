{
  "compilerOptions": {
    "alwaysStrict": true,
    "allowJs": true,
    "baseUrl": "src/",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2019",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    //    "strict": true,
    "target": "ESNext",
    "noEmit": true,
    "paths": {
      "@/adapters/api": [
        "adapters/api"
      ],
      "@/app/*": [
        "app/*"
      ],
      "@/domain": [
        "domain"
      ],
      "@/features/*": [
        "features/*"
      ],
      "@/pages/*": [
        "pages/*"
      ],
      "@/schema/*": [
        "schema/*"
      ],
      "@/shared/*": [
        "shared/*"
      ],
      "@/styles/*": [
        "styles/*"
      ],
      "@/sqlite/*": [
        "adapters/sqlite/*"
      ],
      "@/types": [
        "types"
      ],
      "@/utils/*": [
        "utils/*"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
